generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model StockSnapshot { id BigInt @id @default(autoincrement()); symbol String; tradeDate DateTime; price Decimal?; changePct Decimal?; ttmPe Decimal?; forwardPe Decimal?; estimateUpdatedAt DateTime?; percentile Decimal?; label String; source String; createdAt DateTime @default(now()); @@unique([symbol,tradeDate]) }
model IndexSnapshot { id BigInt @id @default(autoincrement()); symbol String; tradeDate DateTime; ttmPe Decimal?; forwardPe Decimal?; source String; createdAt DateTime @default(now()); @@unique([symbol,tradeDate]) }
model NewsItem { id BigInt @id @default(autoincrement()); symbol String; title String; source String; url String @unique; publishedAt DateTime; summary String?; createdAt DateTime @default(now()) }
model UpdateRun { id BigInt @id @default(autoincrement()); startedAt DateTime @default(now()); finishedAt DateTime?; status String; tradeDate DateTime?; error String? }
